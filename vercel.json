{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/app/(.*\\.(css|js))",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/app/$1"
    },
    {
      "src": "/public/(.*\\.(jpg|jpeg|png|gif|webp|svg|ico))",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/public/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
